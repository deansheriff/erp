# Copy to .env and change every secret. .env is git-ignored; never commit it.

KX_ENV=development
# 32+ random characters. Generate with: uv run kx generate-key
KX_SECRET_KEY=change-me-change-me-change-me-change-me
# Encrypts stored secrets such as the SMTP password and MFA keys (ADR 0011).
# Generate with: uv run kx generate-key --fernet
KX_ENCRYPTION_KEY=

# Database passwords used by docker-compose to create the roles (ADR 0007).
KX_APP_DB_PASSWORD=change-me-app
KX_MIGRATOR_DB_PASSWORD=change-me-migrator
POSTGRES_PASSWORD=change-me-superuser

# The app connects as kx_app; migrations run as kx_migrator.
KX_DATABASE_URL=postgresql+psycopg://kx_app:change-me-app@localhost:5432/kxerp
KX_MIGRATOR_DATABASE_URL=postgresql+psycopg://kx_migrator:change-me-migrator@localhost:5432/kxerp

# Tests use their own database with the same roles.
KX_TEST_DATABASE_URL=postgresql+psycopg://kx_app:change-me-app@localhost:5432/kxerp_test
KX_TEST_MIGRATOR_DATABASE_URL=postgresql+psycopg://kx_migrator:change-me-migrator@localhost:5432/kxerp_test

KX_REDIS_URL=redis://localhost:6379/0
KX_BASE_URL=http://localhost:8000
KX_TIMEZONE=Africa/Lagos

# Object storage (MinIO in development). Used from Phase 5.
MINIO_ROOT_USER=kxminio
MINIO_ROOT_PASSWORD=change-me-minio
KX_S3_ENDPOINT_URL=http://localhost:9000
KX_S3_ACCESS_KEY=kxminio
KX_S3_SECRET_KEY=change-me-minio
# Virus scanning: clamd in docker-compose. accept_all is allowed only outside production.
KX_SCANNER=clamd
KX_CLAMD_HOST=localhost
KX_CLAMD_PORT=3310
