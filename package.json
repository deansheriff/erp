{
  "name": "kxmeleon-erp-assets",
  "private": true,
  "description": "Build-time only: compiles CSS and copies vendored JS, fonts and icons into app/web/static/dist (ADR 0005).",
  "scripts": {
    "build": "npm run build:vendor && npm run build:css",
    "build:vendor": "node scripts/build-assets.mjs",
    "build:css": "tailwindcss -c tailwind.config.js -i app/web/static/src/app.css -o app/web/static/dist/app.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i app/web/static/src/app.css -o app/web/static/dist/app.css --watch"
  },
  "devDependencies": {
    "@alpinejs/csp": "3.14.9",
    "@fontsource-variable/inter": "5.2.5",
    "@fontsource-variable/jetbrains-mono": "5.2.5",
    "@fontsource-variable/plus-jakarta-sans": "5.2.5",
    "@tailwindcss/forms": "0.5.10",
    "htmx.org": "2.0.4",
    "lucide-static": "0.468.0",
    "tailwindcss": "3.4.17"
  }
}
