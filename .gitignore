# --- Secrets and local config: never commit ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/

# --- Data files and dumps: never commit ---
*.csv
*.tsv
*.xlsx
*.xls
*.ofx
*.sql.gz
*.dump
*.bak
*.sqlite
*.sqlite3
*.db
data/
dumps/

# --- Test and tool output ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
test-results/
junit*.xml
.import_linter_cache/

# --- Screenshots and recordings (Stitch screenshots are reviewed, never committed;
#     only the HTML exports in design/stitch/exports are versioned) ---
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.mp4
*.mov
!app/web/static/img/**

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/

# --- Node / front-end build ---
node_modules/
app/web/static/dist/

# --- Editors and OS ---
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# --- Local agent and editor tooling
.claude/
